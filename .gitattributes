# Auto-detect text files and normalize
* text=auto

# Force these files to always use Linux line endings (LF)
# This is critical for Docker and Shell scripts running on Windows
*.sh text eol=lf
*.bash text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf

# (Optional) Keep code consistent across Mac/Windows/Linux devs
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf  